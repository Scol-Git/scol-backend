{
  "name": "scol-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "vercel-build": "npm run build",
    "start:prod": "npm run build && node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "typeorm:gen": "ts-node -r tsconfig-paths/register --transpile-only ./node_modules/typeorm/cli.js migration:generate -d ./src/APP.Infrastructure/db/typeorm/AppDataSource.datasource.ts",
    "typeorm:run": "ts-node -r tsconfig-paths/register --transpile-only ./node_modules/typeorm/cli.js migration:run -d ./src/APP.Infrastructure/db/typeorm/AppDataSource.datasource.ts",
    "typeorm:revert": "ts-node -r tsconfig-paths/register --transpile-only ./node_modules/typeorm/cli.js migration:revert -d ./src/APP.Infrastructure/db/typeorm/AppDataSource.datasource.ts",
    "seed": "ts-node -r tsconfig-paths/register --transpile-only ./seeders/database.seeder.ts"
  },
  "dependencies": {
    "@automapper/classes": "8.8.1",
    "@automapper/core": "8.8.1",
    "@nestjs/common": "11.0.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.1",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/swagger": "11.2.1",
    "@nestjs/typeorm": "11.0.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.8.2",
    "joi": "18.0.1",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "4.4.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.1.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.7",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pino-http": "5.8.4",
    "@types/supertest": "6.0.2",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "16.0.0",
    "jest": "30.2.0",
    "pino-pretty": "13.1.2",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
