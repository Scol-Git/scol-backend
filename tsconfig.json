{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true, // ✅ fixes "default-imported using esModuleInterop" for pino
    "skipLibCheck": true, // ✅ avoids type noise from node_modules
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/APP.API/*"],
      "@bll/*": ["src/APP.BLL/*"],
      "@infra/*": ["src/APP.Infrastructure/*"],
      "@entity/*": ["src/APP.Entity/*"],
      "@shared/*": ["src/APP.Shared/*"]
    },
    "strict": true
  }
}
