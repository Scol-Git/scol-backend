{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist", // ⬅️ compiled JS goes here
    "rootDir": "./src", // ⬅️ all .ts sources live here
    "declaration": false,
    "sourceMap": true,
    "removeComments": true
  },
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
